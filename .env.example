# Copy to .env in the repository root; .env must never be committed.
# Existing shell environment overrides this file, including empty values.
# Values are literal: no $VARIABLE expansion, shell commands or multiline values.

# OpenAI-compatible endpoint. /v1 is appended unless already present.
# Leave BOTH fields empty to run without a model; rule-based demos still work.
COCKPIT_API_BASE=
COCKPIT_API_KEY=

# Exact ID returned by GET /v1/models; empty selects the first Kimi ID.
# Historical benchmark ID: vllm/moonshotai/Kimi-K3 (provider-specific).
COCKPIT_MODEL=

# Optional image-capable model ID from the same provider.
COCKPIT_VISION_MODEL=

# Legacy opt-in credential file containing a URL and an sk- key.
# Used only when API_BASE and API_KEY are both empty. Relative paths use repo root.
# Keep this file outside the repository; there is no default credential path.
COCKPIT_API_FILE=

# Optional public/self-hosted map-service overrides (defaults shown).
# COCKPIT_PHOTON_URL=https://photon.komoot.io/api/
# COCKPIT_OVERPASS_URL=https://overpass-api.de/api/interpreter
# COCKPIT_OSRM_URL=https://router.project-osrm.org
